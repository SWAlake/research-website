---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/paths';
interface Props { paper: CollectionEntry<'papers'>; }
const { paper } = Astro.props;
---
<article class="paper-card">
  <div class="eyebrow">{paper.data.type}{paper.data.year && <><span class="dot">·</span>{paper.data.year}</>}</div>
  <h2><a href={url(`papers/${paper.id}/`)}>{paper.data.title}</a></h2>
  {paper.data.authors.length > 0 && <p>{paper.data.authors.join(', ')}</p>}
  <span class="status">{paper.data.status}</span>
  {paper.data.summary && <p>{paper.data.summary}</p>}
  <a class="text-link" href={url(`papers/${paper.id}/`)}>View details <span aria-hidden="true">↗</span></a>
</article>
