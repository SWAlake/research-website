---
import Layout from '../layouts/Layout.astro';
import { profile, about } from '../data/profile';
import { url } from '../lib/paths';
import ProfileLinks from '../components/ProfileLinks.astro';
import '../styles/about.css';
---
<Layout description={about.description}>
  <div class="about-page shell">
    <div class="about-opening">
      <aside class="about-identity" aria-label="Researcher profile">
        <img class="about-portrait" src={url('images/portrait.webp')} alt="Suliat Wuraola Alake smiling, with auburn hair and a pastel-coloured dress" width="800" height="800" fetchpriority="high" />
        <h1>{profile.name}</h1>
        <p class="about-pronouns">{about.pronouns}</p>
        <p class="about-role">{about.role}</p>
        <p class="about-affiliation">{profile.institution}<br /><span>Australia</span></p>
        <ProfileLinks />
      </aside>
      <section class="about-introduction" aria-labelledby="about-headline">
        <p class="eyebrow">About / Nigerian-Australian researcher</p>
        <h2 id="about-headline">{about.headline}</h2>
        <div class="about-biography">{about.biography.map(paragraph => <p>{paragraph}</p>)}</div>
      </section>
    </div>

    <div class="about-foundations">
      <section class="about-education" aria-labelledby="education">
        <h2 id="education">Education</h2>
        <div class="about-education-grid">
          {about.education.map(degree => (
            <article class="about-degree">
              <div class="about-degree-heading">
                <h3>{degree.title}</h3>
              </div>
              <p>{degree.institution}</p>
            </article>
          ))}
        </div>
      </section>
      <section class="about-interests" aria-labelledby="interests">
        <h2 id="interests">Research interests</h2>
        <ul class="about-interest-tags">{about.interests.map(interest => <li>{interest}</li>)}</ul>
      </section>
    </div>

    <section class="about-research" aria-labelledby="research">
      <h2 id="research">Research in Focus</h2>
      <article class="research-feature-card">
        <div class="research-feature-content">
          <p class="research-feature-category">{about.featuredResearch.category}</p>
          <h3><a href={url(about.featuredResearch.link)}>{about.featuredResearch.title}</a></h3>
          <p class="research-feature-summary"><em>{about.featuredResearch.summary}</em></p>
          <a class="text-link" href={url(about.featuredResearch.link)}>Read research brief <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </section>
  </div>
</Layout>
