---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { url, materialUrl, paperUrl } from '../../lib/paths';
export async function getStaticPaths() { return (await getCollection('journal', ({data}) => !data.draft)).map(entry => ({params:{id:entry.id},props:{entry}})); }
const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedPapers = (await getCollection('papers', ({data}) => !data.draft)).filter(item => entry.data.relatedPapers.includes(item.id));
const relatedJournal = (await getCollection('journal', ({data}) => !data.draft)).filter(item => item.id !== entry.id && entry.data.relatedJournal.includes(item.id));
---
<Layout title={entry.data.title} description={entry.data.summary}><article class="shell article"><a class="text-link" href={url('journal/')}>← Research Journal</a><p class="eyebrow"><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('en-AU',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time> · {Math.max(1,Math.ceil((entry.body ?? '').split(/\s+/).length / 220))} min read</p><h1>{entry.data.title}</h1><p class="lede compact">{entry.data.summary}</p><ul class="tags">{entry.data.tags.map(tag => <li>{tag}</li>)}</ul>{entry.data.image && <img class="article-image" src={materialUrl(entry.data.image.src)} alt={entry.data.image.alt} />}<div class="prose"><Content /></div><div class="materials">{entry.data.materials.map(item => <a href={materialUrl(item.url)}>{item.label}</a>)}</div>{(relatedPapers.length > 0 || relatedJournal.length > 0) && <section class="section"><h2>Related reading</h2>{relatedPapers.map(item => <p><a href={paperUrl(item)}>{item.data.title}</a></p>)}{relatedJournal.map(item => <p><a href={url(`journal/${item.id}/`)}>{item.data.title}</a></p>)}</section>}</article></Layout>
