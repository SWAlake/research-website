---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/paths';
const entries = (await getCollection('journal', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Research Journal" description="Research notes, scientific explanations and reflections by Suliat Wuraola Alake."><div class="shell page"><p class="eyebrow">Notes / Questions / Connections</p><h1>Research Journal</h1><p class="lede">A space to think<br /><em>through the research.</em></p><p class="page-intro">Scientific explanations, research notes and reflections on the questions that shape my work. A record of learning and intellectual development over time.</p>{entries.length === 0 ? <section class="empty"><span class="journal-symbol" aria-hidden="true">∴</span><h2>The first pages are still taking shape.</h2><p>Entries will appear here when they are ready to share.</p><a class="text-link" href={url()}>Explore my research interests ↗</a></section> : <div class="journal-list">{entries.map(entry => <article class="paper-card"><p class="eyebrow"><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('en-AU', {day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time> · {Math.max(1, Math.ceil((entry.body ?? '').split(/\s+/).length / 220))} min read</p><h2><a href={url(`journal/${entry.id}/`)}>{entry.data.title}</a></h2><p>{entry.data.summary}</p><ul class="tags">{entry.data.tags.map(tag => <li>{tag}</li>)}</ul><a class="text-link" href={url(`journal/${entry.id}/`)}>Read entry ↗</a></article>)}</div>}</div></Layout>
